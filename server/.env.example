# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Placeholders only: never put a real password in this file.

# The RUNNING APP's database login: the restricted "tourney_app" user, which
# can read and write the app's tables and nothing else. `npm run db:app-role
# -- --write-env` creates it and fills this in for you.
#   Supabase pooler: postgresql://tourney_app.<project-ref>:<password>@<host>:5432/postgres
#   Local:           postgresql://postgres:devpassword@localhost:5432/haunted
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/haunted

# The database OWNER's login, used only by setup scripts (db:migrate,
# db:lock, db:app-role, admin:create, db:wipe). Leave it out on a deployed
# host: the app itself never needs it.
OWNER_DATABASE_URL=

# Signs admin login tokens. At least 32 random characters, different on every
# deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Without it, admin login and every create/edit/delete route are switched off.
AUTH_SECRET=

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
# Only needed when the website is served from a different address than the API.
CORS_ORIGINS=http://localhost:5173

# Set to production when deployed: no stack traces, and HTTPS-only headers.
NODE_ENV=development

# --- Self-hosting behind a Cloudflare Tunnel (see docs/DEPLOY.md) ---
# Serve the built website (client/dist) from this server too: one address.
SERVE_CLIENT=false
# Accept connections from this machine only; the tunnel connects locally.
HOST=
# Read the visitor's real address from Cloudflare's CF-Connecting-IP header,
# for the login limiter. Only set true when the server is reachable ONLY
# through Cloudflare (with HOST=127.0.0.1), or the header could be faked.
TRUST_CLOUDFLARE=false

# Do NOT set PORT on a managed host; it sets it for you. Defaults to 3000.
